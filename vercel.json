{
  "crons": [
    { "path": "/api/cron-remind?mode=admin", "schedule": "5 16 * * *" },
    { "path": "/api/cron-remind?mode=customer", "schedule": "0 12 * * *" }
  ],
  "rewrites": [
    { "source": "/hair-oracle.html", "destination": "/hair-oracle.html" },
    { "source": "/((?!api/).*\\.html)", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
